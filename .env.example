# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# CLOUD OCR SERVICES (Google Cloud Vision & AWS Textract)
# Provide your Google Cloud Vision API Key for cloud OCR document text detection.
GOOGLE_CLOUD_VISION_API_KEY=MY_VISION_API_KEY
AWS_TEXTRACT_REGION=us-east-1

# SUPABASE_URL & SUPABASE_ANON_KEY:
# Configure your Supabase project URL and public Anon key for Supabase Auth.
SUPABASE_URL=https://cedarwatt.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key


